# Build context is smartmeter/:
#   docker build -f Dockerfile.standalone .
ARG BUILD_FROM=python:3.15-slim
FROM $BUILD_FROM

ENV LANG=C.UTF-8

WORKDIR /app

COPY requirements.txt ./
COPY smartmeter-austria /tmp/smartmeter-austria
RUN pip install --no-cache-dir -r requirements.txt /tmp/smartmeter-austria && \
    rm -rf /tmp/smartmeter-austria

COPY meter ./meter/
# fail the build (and the PR test build) if the app cannot even be imported,
# e.g. a dependency that is incompatible with the base image's Python (#128)
RUN python3 -c "import meter.smartmeter"
COPY config.yaml ./
COPY --chmod=755 standalone-entrypoint.sh ./

ENTRYPOINT ["/app/standalone-entrypoint.sh"]
