# The add-on and standalone images build with the repository root as context
# (smartmeter/Dockerfile*). Only send what they copy.
*
!smartmeter/requirements.txt
!smartmeter/run.sh
!smartmeter/config.yaml
!smartmeter/standalone-entrypoint.sh
!smartmeter/meter
!packages/smartmeter-austria
packages/smartmeter-austria/tests
packages/smartmeter-austria/scripts
**/__pycache__
**/*.pyc
